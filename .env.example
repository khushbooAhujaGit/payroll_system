APP_NAME="HRMS Payroll Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────
# For XAMPP/MySQL: change pgsql → mysql, port 5432 → 3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms_payroll
DB_USERNAME=root
DB_PASSWORD=

# ── Cache & Session (file = no Redis needed) ─────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Queue (sync = no Redis/worker needed) ────────────────────
QUEUE_CONNECTION=sync

# ── Redis (disabled by default - uncomment to enable) ────────
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hr@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum (API Auth) ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8000

# ── File Storage ──────────────────────────────────────────────
FILESYSTEM_DISK=local
